# Server Configuration
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quotes?sslmode=disable

# External Exchange Rate API (exchangeratesapi.io)
EXCHANGE_API_KEY=2270434cad5887ab4ccc50fd5d8cfd16
EXCHANGE_API_BASE_URL=http://api.exchangeratesapi.io/v1/latest
EXCHANGE_API_TIMEOUT=10s
EXCHANGE_API_CACHE_TTL=30s
USE_MOCK_FETCHER=false

# Background Worker Pool & Deduplication
WORKER_COUNT=3
WORKER_QUEUE_SIZE=1000
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=1s
DEDUPLICATION_WINDOW=15s

# Application Mode & Logging
ENVIRONMENT=development
LOG_LEVEL=info
